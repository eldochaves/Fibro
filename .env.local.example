# =====================================================================
# Configuração do Supabase
# Copie este arquivo para ".env.local" e preencha com os valores do
# seu projeto Supabase (Settings -> API).
# =====================================================================

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) Nome exibido no topo do site, ex.: "Clínica Dr. Eldo Chaves"
NEXT_PUBLIC_CLINIC_NAME=

# Observação: o(s) email(s) do(s) médico(s) administrador(es) NÃO ficam
# aqui. Eles são cadastrados na tabela "admin_emails" do banco de dados
# (veja supabase/schema.sql). Assim a permissão de admin é verificada
# com segurança direto no banco (Row Level Security).
